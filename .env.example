APP_NAME="A.V.R. Informatica"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://develop.it/gestavr

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Database MySQL ───────────────────────────────────────────
# Inserisci i dati del database creato in DirectAdmin
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nunzio_gestavr
DB_USERNAME=nunzio_gestavr
DB_PASSWORD=LA_PASSWORD_DEL_DATABASE

# ─── Sessioni e cache su file (non richiede Redis) ───────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file

# ─── Email SMTP Microsoft 365 ─────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=tua@email.it
MAIL_PASSWORD=tuapassword
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS="tua@email.it"
MAIL_FROM_NAME="A.V.R. Informatica"

# Email del rivenditore (riceve le notifiche di scadenza)
RESELLER_EMAIL=tua@email.it
RESELLER_NAME="A.V.R. Informatica"
