APP_NAME="A.V.R. Informatica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Database MySQL ───────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avr_gestionale
DB_USERNAME=root
DB_PASSWORD=

# ─── Sessioni e cache su file (non richiede Redis) ───────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file

# ─── Email SMTP ───────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@avrinformatica.it"
MAIL_FROM_NAME="A.V.R. Informatica"

# Email del rivenditore (riceve le notifiche di scadenza)
RESELLER_EMAIL=info@avrinformatica.it
RESELLER_NAME="A.V.R. Informatica"
